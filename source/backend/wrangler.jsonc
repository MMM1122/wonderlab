{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wonder-lab-api",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "vars": {
    "SITE_URL": "https://wonderlab.observer/",
    "NOTIFY_TO": "yvettewu2017@gmail.com",
    "NOTIFY_FROM": "",
    "TURNSTILE_SITE_KEY": "",
    "OWNER_EMAIL": "yvettewu2017@gmail.com",
    "AUTH_MAIL_PROVIDER": "resend",
    "AUTH_FROM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wonder-lab",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
